{
  "name": "@adnansaliyawala/bharat-mcp",
  "version": "0.4.0",
  "description": "MCP server for India: GST invoices, official GST rates and HSN/SAC search, GSTIN validation, UPI and bank statement (PDF/CSV) analysis, IFSC and PIN code lookup.",
  "mcpName": "io.github.nansa1/bharat-mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bharat-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "update-hsn": "python3 scripts/build_hsn_data.py",
    "update-rates": "python3 scripts/build_gst_rates.py --ctr sources/gazette/ctr-09-2025.pdf --itr sources/gazette/itr-09-2025.pdf --exempt sources/gazette/ctr-10-2025-exemption.pdf --manifest sources/gazette/manifest.json",
    "version": "node scripts/sync-server-json.mjs && git add server.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "india",
    "gst",
    "gstin",
    "upi",
    "invoice",
    "ifsc",
    "pincode",
    "bank-statement",
    "gst-rates",
    "hsn",
    "sac",
    "hsn-code"
  ],
  "author": "nansa1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nansa1/bharat-mcp.git"
  },
  "homepage": "https://github.com/nansa1/bharat-mcp#readme",
  "bugs": {
    "url": "https://github.com/nansa1/bharat-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^7.0.2"
  }
}
